{
  "manifest_version": 3,
  "name": "GCP Currency Converter",
  "version": "1.0.0",
  "description": "Converts HKD to USD in Google Cloud Platform Console",
  "permissions": [],
  "host_permissions": [
    "https://console.cloud.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://console.cloud.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
